FROM ghcr.io/mgdaaslab/wharttest-backend:latest
COPY WHartTest_Django/ /app/
RUN chmod +x /app/entrypoint.sh

# 运行时挂载的 playwright-skill 固定在 Playwright 1.57，和基础镜像中的
# Python Playwright 浏览器版本不同。预装该 Skill 锁定版本的 Chromium，
# 避免首次执行用例时缺少 chromium_headless_shell-1200。
COPY WHartTest_Skills/playwright-skill/package.json WHartTest_Skills/playwright-skill/package-lock.json /opt/playwright-skill/
RUN cd /opt/playwright-skill && npm ci && npx playwright install chromium
